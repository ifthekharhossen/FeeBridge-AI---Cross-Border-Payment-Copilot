# Copy this file to backend/.env and fill in ONLY what you need.
# backend/.env is git-ignored. Never commit real keys. Never put keys in the React app.

# --- Which LLM to use -------------------------------------------------------
# auto              : Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible if its key is set, else DEMO mode
# anthropic         : Claude (needs ANTHROPIC_API_KEY)
# openai_compatible : OpenAI / Groq / Gemini (OpenAI-compatible endpoint) / OpenRouter ... (needs OPENAI_COMPAT_API_KEY)
# demo              : no AI model; deterministic mock agent, clearly labelled in replies
LLM_PROVIDER=auto

# --- Anthropic Claude -------------------------------------------------------
ANTHROPIC_API_KEY=
# Check the current model names in Anthropic's docs; this value is configurable.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Any OpenAI-compatible provider ------------------------------------------
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini
# Examples (verify current URLs/models and free-tier limits in each provider's docs):
#   Groq:   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Behaviour ---------------------------------------------------------------
# If the LLM call fails, answer with the labelled demo logic instead of an error (true/false)
LLM_FALLBACK_TO_DEMO=true
# false (default): student name/ID are replaced by placeholders before text is sent to the LLM provider
LLM_SEND_STUDENT_PII=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
LLM_MAX_TOOL_ROUNDS=5

# --- CORS: comma-separated browser origins allowed to call this API ---------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
